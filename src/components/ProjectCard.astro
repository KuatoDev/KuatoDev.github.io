---
interface Props {
  title: string;
  description: string;
  link: string;
  image: string;
  alt: string;
  actionText?: string;
  isExternal?: boolean;
  imgStyle?: string;
}

const {
  title,
  description,
  link,
  image,
  alt,
  actionText = 'DETAILS',
  isExternal = false,
  imgStyle
} = Astro.props;
---
<div class="project-card">
  <img src={image} alt={alt} loading="lazy" width="350" height="200" style={imgStyle} />
  <h3>{title}</h3>
  <div class="project-overlay">
    <p>{description}</p>
    <a
      href={link}
      class="project-link"
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
    >
      {actionText}
    </a>
  </div>
</div>
