---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  isHome?: boolean;
  showNav?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description,
  image,
  canonicalURL,
  isHome = false,
  showNav = true,
  showFooter = true
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} image={image} canonicalURL={canonicalURL} />
  <slot name="head" />
</head>
<body>
  <div class="background-wrapper" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  {showNav && <Header isHome={isHome} />}
  <slot />
  {showFooter && <Footer />}

  <script src="/script.js" is:inline></script>
</body>
</html>
