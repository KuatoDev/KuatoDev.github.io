---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 - Page Not Found | Vern Kuato"
  description="404 - Page Not Found | Vern Kuato"
  showNav={true}
  showFooter={false}
>
  <main id="main" style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;">
    <div class="card glass-card" style="text-align: center; max-width: 520px; width: 100%; padding: 3rem 2rem; border-radius: 20px;">
      <div style="font-size: 5rem; font-weight: 800; line-height: 1; margin-bottom: 1rem; background: linear-gradient(135deg, var(--primary-accent), var(--orb-3)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        404
      </div>
      <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--text-main);">
        Lost in Cyberspace
      </h1>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem; line-height: 1.6;">
        The page you are looking for has been relocated, deleted, or never existed in this sector.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/index.html" class="btn" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.75rem 1.5rem; font-weight: 600;">
          <span class="material-icons" style="font-size: 20px;" aria-hidden="true">home</span>
          Back to Home
        </a>
        <a href="/blog.html" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.75rem 1.5rem; font-weight: 600;">
          <span class="material-icons" style="font-size: 20px;" aria-hidden="true">article</span>
          Explore Blog
        </a>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Vern Kuato. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
